+          <FormControl
+            v-model="_solution.location"
+            :label="__('Location')"
+            :placeholder="__('Bengaluru')"
+          />
+          <FormControl
+            v-model="_solution.duration"
+            :label="__('Duration (in days/hour)')"
+            :placeholder="__('3 days')"
